<?xml version="1.0" encoding="UTF-8"?>
<layout>
    <grid cols="6" rows="4" gap="10" padding="40" />

    <item id="98" type="clock" locations="{A,0}, {A,1}" />

    

    <item id="5"  data-class="weather-tile" label="Weather" locations="{B,0}, {B,1}" type="content">

        <![CDATA[
        <div data-weather data-lat="50.8225" data-lon="-0.1372"></div>
        ]]>
    </item>

    <item id="12" label="News" locations="{A,2}, {A,3}, {B,2}, {B,3}" type="content">
        <![CDATA[
        <div data-rss-url="https://feeds.bbci.co.uk/news/rss.xml?edition=uk">Loading BBC News...</div>
        ]]>
    </item>

    <item id="chat" label="Chat" locations="{A,4}, {A,5}, {B,4}, {B,5}, {C,4}, {C,5}" type="content" data-class="chatbot-tile">
        <![CDATA[
        <div class="chat-placeholder" data-chat-placeholder>
            <div class="chat-header">Chat</div>
            <div class="chat-messages">
                <div class="chat-msg bot"><span>Hello. How can I help you today?</span></div>
                <div class="chat-msg user"><span>This is a placeholder. Chat coming soon.</span></div>
            </div>
            <div class="chat-input-row">
                <input type="text" class="chat-input" placeholder="Type a message..." disabled>
                <button type="button" class="chat-send" disabled aria-label="Send">Send</button>
            </div>
        </div>
        ]]>
    </item>

    <item id="3" label="Today's calendar events" locations="{C,0}, {C,1}, {D,0}, {D,1}" type="content" />
    <item id="10" label="How to use this dashboard" locations="{D,4}" link="instructions.html"/>
    <item id="10" label="Settings" locations="{D,5}" type="menu" link="settings.html" />

    <item id="6" label="Today's tasks" locations="{C,2}, {C,3}, {D,2}, {D,3}" type="content" />
</layout>
