# Copy to .env (which git ignores) and fill in what you need. server.py reads it at startup.
# Everything here is optional: without it you get live news and weather, and the
# calendar tiles ask you to sign in.

# Show sample calendar events and tasks until someone signs in with Google.
DEMO_MODE=1

# Google Calendar sign-in (an OAuth client of type "Web application" from Google Cloud Console,
# with the Calendar API enabled and BASE_URL/auth/callback added as an authorised redirect URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The address you open the dashboard on. Used to build the OAuth redirect URI.
BASE_URL=http://localhost:5020

# Time zone for the weather forecast and for what counts as "today" on the calendar.
TZ=Europe/London

# Where the Google token and the short-lived sign-in state are stored.
# CALENDAR_TOKEN_FILE=calendar_tokens.json
# AUTH_STATE_FILE=auth_states.json
